/dts-v1/;

/ {
	model = "MTP";
	compatible = "qcom,sm8150-mtp\0qcom,sm8150\0qcom,mtp";
	qcom,board-id = <0x08 0x00>;
	oppo,dtsi_no = <0x4a89>;

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;

			qcom,pm8150@0 {
				compatible = "qcom,spmi-pmic";
				reg = <0x00 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;

				qcom,temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400 0x100>;
					interrupts = <0x00 0x24 0x00 0x01>;
					io-channels = <0x01 0x06>;
					io-channel-names = "thermal";
					#thermal-sensor-cells = <0x00>;
					qcom,temperature-threshold-set = <0x01>;
					phandle = <0x02>;
				};

				qcom,power-on@800 {
					compatible = "qcom,qpnp-power-on";
					reg = <0x800 0x100>;
					interrupts = <0x00 0x08 0x00 0x00 0x00 0x08 0x01 0x00>;
					interrupt-names = "kpdpwr\0resin";
					qcom,pon-dbc-delay = <0x3d09>;
					qcom,kpdpwr-sw-debounce;
					qcom,system-reset;
					qcom,store-hard-reset-reason;
					qcom,pmicwd;

					qcom,pon_1 {
						qcom,pon-type = <0x00>;
						qcom,pull-up;
						linux,code = <0x74>;
					};

					qcom,pon_2 {
						qcom,pon-type = <0x01>;
						qcom,pull-up;
						linux,code = <0x72>;
					};
				};

				clock-controller@5b00 {
					compatible = "qcom,spmi-clkdiv";
					reg = <0x5b00 0x200>;
					#clock-cells = <0x01>;
					qcom,num-clkdivs = <0x02>;
					clock-output-names = "pm8150_div_clk1\0pm8150_div_clk2";
					clocks = <0xffffffff 0x00>;
					clock-names = "xo";
					phandle = <0xc4>;
				};

				qcom,pm8150_rtc {
					compatible = "qcom,qpnp-rtc";
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					qcom,qpnp-rtc-write = <0x00>;
					qcom,qpnp-rtc-alarm-pwrup = <0x00>;
					phandle = <0xc5>;

					qcom,pm8150_rtc_rw@6000 {
						reg = <0x6000 0x100>;
					};

					qcom,pm8150_rtc_alarm@6100 {
						reg = <0x6100 0x100>;
						interrupts = <0x00 0x61 0x01 0x00>;
					};
				};

				pinctrl@c000 {
					compatible = "qcom,spmi-gpio";
					reg = <0xc000 0xa00>;
					interrupts = <0x00 0xc0 0x00 0x00 0x00 0xc2 0x00 0x00 0x00 0xc3 0x00 0x00 0x00 0xc5 0x00 0x00 0x00 0xc6 0x00 0x00 0x00 0xc8 0x00 0x00 0x00 0xc9 0x00 0x00>;
					interrupt-names = "pm8150_gpio1\0pm8150_gpio3\0pm8150_gpio4\0pm8150_gpio6\0pm8150_gpio7\0pm8150_gpio9\0pm8150_gpio10";
					gpio-controller;
					#gpio-cells = <0x02>;
					qcom,gpios-disallowed = <0x02 0x05 0x08>;
					phandle = <0x08>;

					key_home {

						key_home_default {
							pins = "gpio1";
							function = "normal";
							input-enable;
							bias-pull-up;
							power-source = <0x00>;
							phandle = <0xc6>;
						};
					};

					key_vol_up {

						key_vol_up_default {
							pins = "gpio6";
							function = "normal";
							input-enable;
							bias-pull-up;
							power-source = <0x01>;
							phandle = <0x94>;
						};
					};

					key_vol_down {

						key_vol_down_default {
							pins = "gpio7";
							function = "normal";
							input-enable;
							bias-pull-up;
							power-source = <0x01>;
							phandle = <0x95>;
						};
					};

					usb2_vbus_boost {

						usb2_vbus_boost_default {
							pins = "gpio9";
							function = "normal";
							output-low;
							power-source = <0x01>;
							phandle = <0xc7>;
						};
					};

					usb2_vbus_det {

						usb2_vbus_det_default {
							pins = "gpio10";
							function = "normal";
							input-enable;
							bias-pull-down;
							power-source = <0x01>;
							phandle = <0xc8>;
						};
					};

					cam_rear_reset_act {

						cam_rear_reset_active {
							pins = "gpio1";
							function = "normal";
							power-source = <0x00>;
							output-low;
							phandle = <0x6a>;
						};
					};

					cam_rear_reset_susp {

						cam_rear_reset_suspend {
							pins = "gpio1";
							function = "normal";
							power-source = <0x00>;
							output-low;
							phandle = <0x6b>;
						};
					};

					dischg_enable {
						pins = "gpio9";
						function = "normal";
						bias-disable;
						power-source = <0x00>;
						output-high;
						qcom,drive-strength = <0x03>;
						phandle = <0x0a>;
					};

					dischg_disable {
						pins = "gpio9";
						function = "normal";
						bias-disable;
						power-source = <0x00>;
						output-low;
						qcom,drive-strength = <0x03>;
						phandle = <0x0b>;
					};

					mps_otg_en_active {
						pins = "gpio4";
						function = "normal";
						bias-disable;
						power-source = <0x01>;
						output-high;
						qcom,drive-strength = <0x03>;
						phandle = <0x9c>;
					};

					mps_otg_en_sleep {
						pins = "gpio4";
						function = "normal";
						bias-disable;
						power-source = <0x01>;
						output-low;
						qcom,drive-strength = <0x03>;
						phandle = <0x9d>;
					};

					mps_otg_en_default {
						pins = "gpio4";
						function = "normal";
						bias-disable;
						power-source = <0x01>;
						output-low;
						qcom,drive-strength = <0x03>;
						phandle = <0x9e>;
					};
				};

				sdam@b100 {
					compatible = "qcom,spmi-sdam";
					reg = <0xb100 0x100>;
					phandle = <0x14>;
				};

				vadc@3100 {
					compatible = "qcom,spmi-adc5";
					reg = <0x3100 0x100>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupts = <0x00 0x31 0x00 0x01>;
					interrupt-names = "eoc-int-en-set";
					qcom,adc-vdd-reference = <0x753>;
					#io-channel-cells = <0x01>;
					io-channel-ranges;
					phandle = <0x01>;

					ref_gnd {
						reg = <0x00>;
						label = "ref_gnd";
						qcom,pre-scaling = <0x01 0x01>;
					};

					vref_1p25 {
						reg = <0x01>;
						label = "vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					die_temp {
						reg = <0x06>;
						label = "die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					vph_pwr {
						reg = <0x83>;
						label = "vph_pwr";
						qcom,pre-scaling = <0x01 0x03>;
					};

					vcoin {
						reg = <0x85>;
						label = "vcoin";
						qcom,pre-scaling = <0x01 0x03>;
					};

					xo_therm {
						reg = <0x4c>;
						label = "xo_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					skin_therm {
						reg = <0x4d>;
						label = "skin_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					pa_therm1 {
						reg = <0x4e>;
						label = "pa_therm1";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};
				};

				adc_tm@3500 {
					compatible = "qcom,adc-tm5";
					reg = <0x3500 0x100>;
					interrupts = <0x00 0x35 0x00 0x01>;
					interrupt-names = "thr-int-en";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#thermal-sensor-cells = <0x01>;
					io-channels = <0x01 0x4c 0x01 0x4d 0x01 0x4e>;
					phandle = <0x9a>;

					xo_therm {
						reg = <0x4c>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					skin_therm {
						reg = <0x4d>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					pa_therm1 {
						reg = <0x4e>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};
				};
			};

			qcom,pm8150@1 {
				compatible = "qcom,spmi-pmic";
				reg = <0x01 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;
			};
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {

			pm8150_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <0x02>;
				wake-capable-sensor;
				phandle = <0xc9>;

				trips {

					trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x83>;
					};

					trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x84>;
					};

					trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "passive";
					};
				};
			};
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;

			qcom,pm8150b@2 {
				compatible = "qcom,spmi-pmic";
				reg = <0x02 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;

				qcom,revid@100 {
					compatible = "qcom,qpnp-revid";
					reg = <0x100 0x100>;
					phandle = <0x06>;
				};

				qcom,power-on@800 {
					compatible = "qcom,qpnp-power-on";
					reg = <0x800 0x100>;
				};

				qcom,temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400 0x100>;
					interrupts = <0x02 0x24 0x00 0x01>;
					io-channels = <0x03 0x06>;
					io-channel-names = "thermal";
					#thermal-sensor-cells = <0x00>;
					qcom,temperature-threshold-set = <0x01>;
					phandle = <0x17>;
				};

				clock-controller@6000 {
					compatible = "qcom,spmi-clkdiv";
					reg = <0x6000 0x100>;
					#clock-cells = <0x01>;
					qcom,num-clkdivs = <0x01>;
					clock-output-names = "pm8150b_div_clk1";
					clocks = <0xffffffff 0x00>;
					clock-names = "xo";
					phandle = <0xca>;
				};

				qcom,pbs@7200 {
					compatible = "qcom,qpnp-pbs";
					reg = <0x7200 0x100>;
					phandle = <0xcb>;
				};

				qcom,sdam-qnovo@b000 {
					compatible = "qcom,qpnp-qnovo5";
					reg = <0xb000 0x100>;
					interrupts = <0x02 0xb0 0x01 0x01>;
					interrupt-names = "ptrain-done";
					pinctrl-names = "q_state1\0q_state2";
					pinctrl-0 = <0x04>;
					pinctrl-1 = <0x05>;
					phandle = <0xcc>;
				};

				pinctrl@c000 {
					compatible = "qcom,spmi-gpio";
					reg = <0xc000 0xc00>;
					interrupts = <0x02 0xc0 0x00 0x00 0x02 0xc1 0x00 0x00 0x02 0xc4 0x00 0x00 0x02 0xc5 0x00 0x00 0x02 0xc6 0x00 0x00 0x02 0xc7 0x00 0x00 0x02 0xc8 0x00 0x00 0x02 0xc9 0x00 0x00 0x02 0xca 0x00 0x00 0x02 0xcb 0x00 0x00>;
					interrupt-names = "pm8150b_gpio1\0pm8150b_gpio2\0pm8150b_gpio5\0pm8150b_gpio6\0pm8150b_gpio7\0pm8150b_gpio8\0pm8150b_gpio9\0pm8150b_gpio10\0pm8150b_gpio11\0pm8150b_gpio12";
					gpio-controller;
					#gpio-cells = <0x02>;
					qcom,gpios-disallowed = <0x03 0x04>;
					phandle = <0x97>;

					smb_stat {

						smb_stat_default {
							pins = "gpio6";
							function = "normal";
							input-enable;
							bias-pull-up;
							qcom,pull-up-strength = <0x00>;
							power-source = <0x00>;
							phandle = <0x8b>;
						};
					};

					qnovo_fet_ctrl {

						qnovo_fet_ctrl_state1 {
							pins = "gpio8";
							function = "normal";
							input-enable;
							output-disable;
							bias-disable;
							power-source = <0x00>;
							phandle = <0x04>;
						};

						qnovo_fet_ctrl_state2 {
							pins = "gpio8";
							function = "normal";
							input-enable;
							output-disable;
							bias-pull-down;
							power-source = <0x00>;
							phandle = <0x05>;
						};
					};

					cam_front_vana {

						cam_front_vana_default {
							pins = "gpio12";
							function = "normal";
							power-source = <0x00>;
							output-low;
							phandle = <0xcd>;
						};
					};

					cam_front_vdig {

						cam_front_vdig_default {
							pins = "gpio10";
							function = "normal";
							power-source = <0x00>;
							output-low;
							phandle = <0xce>;
						};
					};

					hw_sub1_gpio_active {

						hw_sub1_pullup {
							pins = "gpio8";
							function = "normal";
							input-enable;
							bias-pull-up;
							power-source = <0x01>;
							phandle = <0x98>;
						};
					};

					hw_sub1_gpio_sleep {

						hw_sub1_pulldown {
							pins = "gpio8";
							function = "normal";
							input-enable;
							bias-pull-down;
							power-source = <0x01>;
							phandle = <0x99>;
						};
					};

					gpio7_adc {

						gpio7_adc_default {
							pins = "gpio7";
							function = "normal";
							bias-high-impedance;
							phandle = <0x09>;
						};
					};

					gpio1_adc {

						gpio1_adc_default {
							pins = "gpio1";
							function = "normal";
							bias-high-impedance;
							phandle = <0x0c>;
						};
					};

					gpio12_adc {

						gpio12_adc_default {
							pins = "gpio12";
							function = "normal";
							bias-high-impedance;
							phandle = <0x0d>;
						};
					};
				};

				vadc@3100 {
					compatible = "qcom,spmi-adc5";
					reg = <0x3100 0x100 0x3700 0x100>;
					reg-names = "adc5-usr-base\0adc5-cal-base";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupts = <0x02 0x31 0x00 0x01>;
					interrupt-names = "eoc-int-en-set";
					qcom,adc-vdd-reference = <0x753>;
					#io-channel-cells = <0x01>;
					io-channel-ranges;
					phandle = <0x03>;

					ref_gnd {
						reg = <0x00>;
						label = "ref_gnd";
						qcom,pre-scaling = <0x01 0x01>;
					};

					vref_1p25 {
						reg = <0x01>;
						label = "vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					die_temp {
						reg = <0x06>;
						label = "die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					chg_temp {
						reg = <0x09>;
						label = "chg_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					v_i_int_ext {
						reg = <0xb0>;
						label = "v_i_int_vbat_vdata";
						qcom,pre-scaling = <0x01 0x01>;
					};

					v_i_ext {
						reg = <0xb2>;
						label = "v_i_int_ext_vbat_vdata";
						qcom,pre-scaling = <0x01 0x01>;
					};

					v_i_parallel {
						reg = <0xb4>;
						label = "v_i_parallel_vbat_vdata";
						qcom,pre-scaling = <0x01 0x01>;
					};

					smb1390_therm {
						reg = <0x0e>;
						label = "smb1390_therm";
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					smb1355_therm {
						reg = <0x4e>;
						label = "smb1355_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					chgID_voltage_adc {
						reg = <0x14>;
						label = "chgID_voltage_adc";
						qcom,pre-scaling = <0x01 0x01>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					usb_temp_adc {
						reg = <0x50>;
						label = "usb_temp_adc";
						qcom,pre-scaling = <0x01 0x01>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					usb_supplementary_temp_adc {
						reg = <0x53>;
						label = "usb_supplementary_temp_adc";
						qcom,pre-scaling = <0x01 0x01>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					vph_pwr {
						reg = <0x83>;
						label = "vph_pwr";
						qcom,pre-scaling = <0x01 0x03>;
					};

					wp_therm {
						reg = <0x4d>;
						label = "wp_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					vcoin {
						reg = <0x85>;
						label = "vcoin";
						qcom,pre-scaling = <0x01 0x03>;
					};

					conn_therm {
						reg = <0x4f>;
						label = "conn_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					chg_sbux {
						reg = <0x99>;
						label = "chg_sbux";
						qcom,pre-scaling = <0x01 0x03>;
					};

					mid_chg_div6 {
						reg = <0x1e>;
						label = "chg_mid";
						qcom,pre-scaling = <0x01 0x06>;
					};

					usb_in_i_uv {
						reg = <0x07>;
						label = "usb_in_i_uv";
						qcom,pre-scaling = <0x01 0x01>;
					};

					usb_in_v_div_16 {
						reg = <0x08>;
						label = "usb_in_v_div_16";
						qcom,pre-scaling = <0x01 0x10>;
					};
				};

				adc_tm@3500 {
					compatible = "qcom,adc-tm5";
					reg = <0x3500 0x100>;
					interrupts = <0x02 0x35 0x00 0x01>;
					interrupt-names = "thr-int-en";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#thermal-sensor-cells = <0x01>;
					io-channels = <0x03 0x4d>;
					qcom,pmic-revid = <0x06>;
					phandle = <0x16>;

					wp_therm {
						reg = <0x4d>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};
				};

				qcom,qpnp-smb5 {
					compatible = "qcom,qpnp-smb5";
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					#cooling-cells = <0x02>;
					qcom,pmic-revid = <0x06>;
					qcom,thermal-mitigation = <0x2dc6c0 0x16e360 0xf4240 0x7a120>;
					qcom,chg-term-src = <0x01>;
					qcom,charger-temp-max = <0x320>;
					qcom,smb-temp-max = <0x320>;
					qcom,usb-icl-ua = <0x1e8480>;
					qcom,fcc-max-ua = <0x1e8480>;
					qcom,qc3-disable;
					qcom,hvdcp-disable;
					qcom,float-option = <0x01>;
					qcom,oplus-pps-usbpd-detection = <0x07>;
					qcom,input_current_charger_ma = <0x7d0>;
					qcom,pd_input_current_charger_ma = <0x7d0>;
					qcom,qc_input_current_charger_ma = <0x7d0>;
					qcom,input_current_usb_ma = <0x1f4>;
