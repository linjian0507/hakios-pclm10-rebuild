				mux {
					pins = "gpio77\0gpio148\0gpio166\0gpio165";
					function = "gpio";
				};

				config {
					pins = "gpio77\0gpio148\0gpio166\0gpio165";
					bias-disable;
					drive-strength = <0x02>;
					output-high;
				};
			};

			cam_sensor_rear2_suspend {
				phandle = <0xfb>;

				mux {
					pins = "gpio77\0gpio148\0gpio166\0gpio165";
					function = "gpio";
				};

				config {
					pins = "gpio77\0gpio148\0gpio166\0gpio165";
					bias-pull-down;
					drive-strength = <0x02>;
					output-low;
				};
