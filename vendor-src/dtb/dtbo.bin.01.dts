	fragment@45 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			qcom,smb1390@10 {
				compatible = "qcom,i2c-pmic";
				reg = <0x10>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				interrupt-parent = <0xffffffff>;
				interrupts = <0x02 0xc5 0x00 0x08>;
				interrupt_names = "smb1390";
				interrupt-controller;
				#interrupt-cells = <0x03>;
				qcom,periph-map = <0x10>;
				status = "ok";
				pinctrl-names = "default";
				pinctrl-0 = <0x8b>;
				phandle = <0x8d>;

				qcom,revid {
					compatible = "qcom,qpnp-revid";
					reg = <0x100>;
					phandle = <0x8c>;
				};

				qcom,charge_pump {
					compatible = "qcom,smb1390-charger-psy";
					qcom,pmic-revid = <0x8c>;
					interrupt-parent = <0x8d>;
					status = "ok";
					io-channels = <0x03 0x0e>;
					io-channel-names = "cp_die_temp";
					phandle = <0x107>;

					qcom,core {
						interrupts = <0x10 0x00 0x03 0x10 0x01 0x03 0x10 0x02 0x03 0x10 0x03 0x03 0x10 0x04 0x03 0x10 0x05 0x01 0x10 0x06 0x01 0x10 0x07 0x01>;
						interrupt-names = "switcher-off-window\0switcher-off-fault\0tsd-fault\0irev-fault\0vph-ov-hard\0vph-ov-soft\0ilim\0temp-alarm";
					};
				};
			};

			qcom,smb1390_slave@18 {
				compatible = "qcom,i2c-pmic";
				reg = <0x18>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				qcom,periph-map = <0x10>;
				status = "disabled";
				phandle = <0x108>;

				qcom,charge_pump_slave {
					compatible = "qcom,smb1390-slave";
					status = "disabled";
					phandle = <0x109>;
				};
			};

			qcom,smb1355@c {
				compatible = "qcom,i2c-pmic";
				reg = <0x0c>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				interrupt-parent = <0xffffffff>;
				interrupts = <0x02 0xc5 0x00 0x08>;
				interrupt_names = "smb1355";
				interrupt-controller;
				#interrupt-cells = <0x03>;
				qcom,periph-map = <0x10 0x12 0x13 0x16>;
				status = "ok";
				phandle = <0x8f>;

				qcom,revid@100 {
					compatible = "qcom,qpnp-revid";
					reg = <0x100 0x100>;
					phandle = <0x8e>;
				};

				qcom,smb1355-charger@1000 {
					compatible = "qcom,smb1355";
					qcom,pmic-revid = <0x8e>;
					reg = <0x1000 0x700>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					interrupt-parent = <0x8f>;
					status = "ok";
					io-channels = <0x03 0x0e>;
					io-channel-names = "charger_temp";
					phandle = <0x10a>;

					qcom,chgr@1000 {
						reg = <0x1000 0x100>;
						interrupts = <0x10 0x01 0x01>;
						interrupt-names = "chg-state-change";
					};

					qcom,chgr-misc@1600 {
						reg = <0x1600 0x100>;
						interrupts = <0x16 0x01 0x01 0x16 0x06 0x01>;
						interrupt-names = "wdog-bark\0temperature-change";
					};
				};
			};

			qcom,pm8008@8 {
				compatible = "qcom,i2c-pmic";
				reg = <0x08>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x10b>;

				qcom,pm8008-chip@900 {
					compatible = "qcom,pm8008-chip";
					reg = <0x900>;
					pinctrl-names = "default";
					pinctrl-0 = <0x90>;
					phandle = <0x10c>;

					qcom,pm8008-chip-en {
						regulator-name = "pm8008-chip-en";
						phandle = <0x91>;
					};
				};

				qcom,revid@100 {
					compatible = "qcom,qpnp-revid";
					reg = <0x100>;
				};

